{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey={env_id};IngestionEndpoint={env_ingestion_endpoint};LiveEndpoint={env_live_endpoint};ApplicationId={env_app_id}"
  }
}