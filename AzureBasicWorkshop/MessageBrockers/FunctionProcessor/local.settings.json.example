{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "ServiceBusConnection": "<service-bus-connection-string-for-local-dev>",
    "ServiceBusQueueName": "webapp-to-function-queue",
    "ServiceBusTopicName": "webapp-events-topic",
    "ServiceBusTopicSubscriptionName": "function-processor-sub",
    "EventHubConnection": "<event-hub-connection-string-for-local-dev>",
    "EventHubName": "webapp-events-hub",
    "EventHubConsumerGroup": "$Default"
  }
}