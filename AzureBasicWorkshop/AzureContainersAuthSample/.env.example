# Azure Active Directory (Microsoft Entra ID) Configuration
# Скопируйте этот файл в .env и заполните реальными значениями

# Tenant ID - ID вашего Azure AD tenant
# Для мультитенантности используйте "common"
AZURE_TENANT_ID=common

# Client ID - Application (client) ID из App Registration
AZURE_CLIENT_ID=11111111-1111-1111-1111-111111111111

# Client Secret - секрет приложения из App Registration
# ВАЖНО: Не коммитьте этот файл с реальными значениями!
AZURE_CLIENT_SECRET=your-client-secret-here

# Redirect URI должен быть зарегистрирован в Azure AD:
# http://localhost:5000/signin-oidc
