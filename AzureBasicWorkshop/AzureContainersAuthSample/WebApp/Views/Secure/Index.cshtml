@model IReadOnlyCollection<WebApp.Controllers.SecureClaimViewModel>

@{
    ViewData["Title"] = "Защищенная зона";
}

<div class="mb-4">
    <h1 class="display-6">Защищенная страница</h1>
    <p class="text-muted mb-0">Эта страница доступна только после входа через Microsoft Entra ID.</p>
</div>

<div class="card">
    <div class="card-header">
        <strong>Claims текущего пользователя</strong>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Тип</th>
                    <th>Значение</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td><code>@claim.Type</code></td>
                        <td>@claim.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
